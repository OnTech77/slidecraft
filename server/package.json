{
  "name": "slidecraft-server",
  "private": true,
  "version": "0.1.0",
  "description": "Slidecraft API: Markdown parsing, AI enhancement and PDF export.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "nodemonConfig": {
    "watch": [
      "index.js",
      "app.js",
      "routes",
      "services",
      "utils",
      "themes"
    ],
    "ext": "js,css,json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
