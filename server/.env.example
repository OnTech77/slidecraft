# Copy this file to .env and fill in the values.

# Port the API listens on.
PORT=3001

# Origin of the React client (used for CORS in development).
CLIENT_ORIGIN=http://localhost:5173

# OpenAI settings. Leave OPENAI_API_KEY empty to run without AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local model through Ollama (https://ollama.com). Pick it from the "AI model" menu in the Enhance step.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Provider selected by default: openai or ollama. Empty means OpenAI when a key is set, otherwise Ollama.
AI_PROVIDER=
