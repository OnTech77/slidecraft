# Copy this file to .env and fill in the values.

# Port the API listens on.
PORT=3001

# Origin of the React client (used for CORS in development).
CLIENT_ORIGIN=http://localhost:5173

# Anthropic (Claude) settings. Leave ANTHROPIC_API_KEY empty to run without AI features.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
